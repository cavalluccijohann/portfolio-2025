# Contact form + chat "contact" tool (Resend)
RESEND_API_KEY=re_xxx

# Nuxt Studio (GitHub OAuth app)
STUDIO_GITHUB_CLIENT_ID=<your_client_id>
STUDIO_GITHUB_CLIENT_SECRET=<your_client_secret>

# Chat assistant (Vercel AI Gateway)
AI_GATEWAY_API_KEY=vck_xxx
CHAT_ENABLED=true

# Rate limiting (required: chat and contact are fail-closed without Redis)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx
# Or TCP Redis instead of Upstash REST:
# REDIS_URL=rediss://default:password@host:6379

CHAT_IP_LIMIT_PER_DAY=3
CHAT_GLOBAL_LIMIT_PER_DAY=40
EMAIL_IP_LIMIT_PER_DAY=5
EMAIL_GLOBAL_LIMIT_PER_DAY=40
# CHAT_TRUSTED_IPS=1.2.3.4,5.6.7.8

# Vercel Cron (/api/cron/redis-keepalive)
CRON_SECRET=<random-long-secret>
